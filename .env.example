# Copy to .env and fill in. Never commit .env.
# Adding a variable? Also add it to the GitHub `production` environment and the deploy step
# (see docs/deployment.md), except DATABASE_URL which production compose builds itself.

# Signed admin sessions: generate with openssl rand -hex 32 (required).
SESSION_SECRET=

# Encrypts Provider API keys at rest: generate with openssl rand -hex 32 (required).
# Changing it makes stored keys undecryptable.
MASTER_KEY=

# HTTP server port (default 3000; no production environment variable required).
# Use 3001 locally: Vite owns localhost:3000 and proxies to this port.
HTTP_PORT=3001

# Local dev talks to the compose Postgres on localhost.
DATABASE_URL=postgres://tanomu:tanomu@localhost:54329/tanomu

# Feishu developer console → your app → Credentials & Basic Info
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Chat model Provider. Protocol: openai | anthropic | google
# Imported once into the database as Provider "Default" and the chat Binding when none exists.
# Replies use the stored Binding. Once one exists, these lines may be removed or commented out;
# blank values are rejected, and production keeps them set until the final cleanup PR.
CHAT_PROVIDER_PROTOCOL=openai
CHAT_PROVIDER_BASE_URL=
CHAT_PROVIDER_API_KEY=
CHAT_MODEL=
# Whether CHAT_MODEL accepts images: true | false (default false declines images).
CHAT_MODEL_VISION=false
