{
  "name": "@tanomu/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch src/main.ts",
    "start": "node src/main.ts",
    "typecheck": "tsc -p .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env src/db/migrate.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.81",
    "@ai-sdk/google": "^4.0.98",
    "@ai-sdk/openai": "^4.0.95",
    "@larksuiteoapi/node-sdk": "^1.76.0",
    "@tanomu/core": "workspace:*",
    "ai": "^7.0.142",
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11"
  }
}
