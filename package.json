{
  "name": "tanomu",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @tanomu/server dev",
    "lint": "oxlint --type-aware",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:db": "TEST_DATABASE_URL=postgres://tanomu:tanomu@localhost:54329/tanomu_test vitest run",
    "db:generate": "pnpm --filter @tanomu/server db:generate",
    "db:migrate": "pnpm --filter @tanomu/server db:migrate"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.20.0"
}
